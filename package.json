{
  "name": "@hardgraph/skills",
  "version": "0.0.0",
  "private": true,
  "description": "Public, installable agent skills curated by Hardgraph.",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "check": "pnpm validate && pnpm format:check",
    "check:publishable": "pnpm validate:publishable && skills add . --list",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "node scripts/validate-skills.mjs",
    "validate:publishable": "node scripts/validate-skills.mjs --require-skill"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "skills": "1.5.22",
    "yaml": "2.9.0"
  }
}
